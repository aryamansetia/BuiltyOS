# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas or hosted MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/builtyos

# Authentication Security
JWT_SECRET=replace_this_with_a_strong_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Simulation Services
GPS_SIMULATION_INTERVAL_MS=20000

# Frontend Allowed Origin (for CORS, comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

